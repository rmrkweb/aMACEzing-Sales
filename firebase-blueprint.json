{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile representation in Firestore",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "Display name of the user" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update server timestamp" }
      },
      "required": ["uid", "email"]
    },
    "Business": {
      "title": "Business",
      "description": "Represents an active business entity (Engraving or Sintra Board)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique business identifier" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "name": { "type": "string", "description": "Business display name" },
        "type": { "type": "string", "enum": ["ENGRAVING", "SINTRA_BOARD"], "description": "Business type" },
        "orderPrefix": { "type": "string", "description": "Prefix used for order numbering" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp" }
      },
      "required": ["id", "userId", "name", "type", "orderPrefix"]
    },
    "Product": {
      "title": "Product",
      "description": "A catalog product with selling price and unit cost",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique product ID" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "name": { "type": "string", "description": "Product title" },
        "businessType": { "type": "string", "enum": ["ENGRAVING", "SINTRA_BOARD"], "description": "Associated business" },
        "sellingPrice": { "type": "number", "description": "Unit selling price in PHP" },
        "unitCost": { "type": "number", "description": "Unit cost in PHP" },
        "isActive": { "type": "boolean", "description": "Active in catalog" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp" }
      },
      "required": ["id", "userId", "name", "businessType", "sellingPrice", "unitCost", "isActive"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer contact and notes directory record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique customer ID" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "name": { "type": "string", "description": "Customer full name or company" },
        "phone": { "type": "string", "description": "Contact number" },
        "email": { "type": "string", "description": "Contact email" },
        "notes": { "type": "string", "description": "General customer remarks" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp" }
      },
      "required": ["id", "userId", "name"]
    },
    "SalesTransaction": {
      "title": "SalesTransaction",
      "description": "Sales transaction with line items and financial metrics",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique transaction UUID" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "orderNumber": { "type": "string", "description": "Human-readable order sequence" },
        "businessType": { "type": "string", "enum": ["ENGRAVING", "SINTRA_BOARD"], "description": "Business type" },
        "customerName": { "type": "string", "description": "Name of the customer" },
        "orderDateEpochMillis": { "type": "number", "description": "Order date in epoch milliseconds" },
        "discountType": { "type": "string", "enum": ["PERCENTAGE", "FIXED"], "description": "Discount calculation type" },
        "discountPercentage": { "type": "number", "description": "Percentage discount applied" },
        "discountAmount": { "type": "number", "description": "Fixed discount in PHP" },
        "grossSales": { "type": "number", "description": "Gross total sales in PHP" },
        "netSales": { "type": "number", "description": "Net sales after discount in PHP" },
        "totalProductCost": { "type": "number", "description": "Total cost of goods sold" },
        "estimatedProfit": { "type": "number", "description": "Calculated profit in PHP" },
        "paymentStatus": { "type": "string", "enum": ["PENDING", "PARTIALLY_PAID", "PAID", "CANCELLED"], "description": "Current payment status" },
        "amountPaid": { "type": "number", "description": "Total amount paid to date" },
        "outstandingBalance": { "type": "number", "description": "Remaining receivable balance" },
        "paymentNotes": { "type": "string", "description": "Payment transaction notes" },
        "remarks": { "type": "string", "description": "General order notes" },
        "lineItemsSummary": { "type": "string", "description": "Human-readable summary of items" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp" }
      },
      "required": ["id", "userId", "orderNumber", "businessType", "customerName", "grossSales", "netSales", "estimatedProfit", "paymentStatus", "amountPaid", "outstandingBalance"]
    },
    "Settings": {
      "title": "Settings",
      "description": "User application preferences and business calculation rules",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Settings document ID" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "businessNameEngraving": { "type": "string", "description": "Name of engraving business" },
        "businessNameSintra": { "type": "string", "description": "Name of sintra board business" },
        "engravingOrderPrefix": { "type": "string", "description": "Prefix for engraving orders" },
        "sintraOrderPrefix": { "type": "string", "description": "Prefix for sintra board orders" },
        "sintraDefaultMarginPercent": { "type": "number", "description": "Default profit margin % for Sintra Board" },
        "sintraUseCostCalculation": { "type": "boolean", "description": "Whether to use unit costs for Sintra Board" },
        "currencySymbol": { "type": "string", "description": "Currency symbol" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp" }
      },
      "required": ["id", "userId", "businessNameEngraving", "businessNameSintra", "engravingOrderPrefix", "sintraOrderPrefix", "sintraDefaultMarginPercent", "sintraUseCostCalculation"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Root user profile document"
    },
    "/users/{userId}/businesses/{businessId}": {
      "schema": { "$ref": "#/entities/Business" },
      "description": "Businesses managed by this user"
    },
    "/users/{userId}/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Products catalog for this user"
    },
    "/users/{userId}/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Customers directory for this user"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/SalesTransaction" },
      "description": "Sales transactions for this user"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/Settings" },
      "description": "Application settings and business rules"
    }
  }
}
